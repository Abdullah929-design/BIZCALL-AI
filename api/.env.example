# Environment Configuration for Banking & Marketing API

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Model Configuration
INTENT_MODEL_PATH=../intent_detection_model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma-banking
OLLAMA_MARKETING_MODEL=finance-chat:latest

# FAQ Configuration
FAQ_INDEX_PATH=../faq_engine/banking_training_dataset.json
FAQ_DIMENSION=384

# Session Configuration
SESSION_TIMEOUT=3600  # 1 hour in seconds
MAX_SESSIONS=1000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Logging
LOG_LEVEL=info
