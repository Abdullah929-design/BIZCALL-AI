def predict_multiple_intents(text: str) -> Tuple[List[Dict], str]:
    model, tokenizer = load_intent_model()
    
    # basic splitting strategy: split on "but", "and", "also" - keep it simple
    segments = re.split(r'\b(?:but|however|also|and|then|additionally|plus)\b', text)
    # ↑ ANNOTATION: This is 'Rule-Based Segmentation'. While we could use 
    # a model to split sentences, regex is 1000x faster and works for 
    # 90% of banking queries where users concatenate problems with 'and'.
    
    segments = [s.strip() for s in segments if s.strip()]

    results = []
    detected = []
    for seg in segments:
        top = predict_top_k(seg, model, tokenizer, top_k=5, temperature=1.0, min_confidence=0.05)
        
        top = apply_overrides_and_hints(seg, top)
        # ↑ ANNOTATION: This is a 'Safety Layer'. If the user mentions 
        # 'fraud', we inject that intent with 100% confidence even if 
        # the model missed it. Never trust a model with security.
        
        formatted = prioritize_and_format(top, top_n=3)
        # ↑ ANNOTATION: We prioritize by severity (Priority 10 vs 1). 
        # If someone has a lost card (10) and a balance question (1), 
        # we MUST address the lost card first.
        
        primary = formatted[0]["intent"] if formatted else None
        results.append({
            "text": seg,
            "primary_intent": primary,
            "intents": formatted
        })
        detected.extend([f["intent"] for f in formatted])

    unique = list(dict.fromkeys(detected))
    complexity = classify_query_complexity(unique)
    # ↑ ANNOTATION: Complexity is the 'Dispatcher' logic. 
    # If segments > 1 or intent is 'complex', we route to the LLM. 
    # Otherwise, a simple FAQ lookup is enough.
    
    return results, complexity
```

