def predict_top_k(text: str, model, tokenizer, top_k: int = 5, temperature: float = 1.0, min_confidence: float = 0.05):
    text_proc = preprocess_text(text)
    # ↑ ANNOTATION: Preprocessing removes 'filler' words like 'um' and 'uh'. 
    # This is critical because transformer models have a finite 'attention' window. 
    # Garbage in = Garbage out.
    
    inputs = tokenizer(
        text_proc,
        padding="max_length",
        truncation=True,
        max_length=128,
        return_tensors="pt",
    )
    # ↑ ANNOTATION: Tokenization turns text into numbers (vectors). 
    # Padding to 128 ensures every batch has the same shape for the GPU/CPU.
    
    with torch.no_grad():
        outputs = model(**inputs)
        logits = outputs.logits
    # ↑ ANNOTATION: 'no_grad' tells PyTorch not to calculate gradients. 
    # This saves massive amounts of memory and speed because we are doing 
    # INFERENCE, not TRAINING. 'logits' are the raw, unnormalized AI scores.
    
    logits_scaled = logits / temperature
    # ↑ ANNOTATION: This is the Temperature scaling we talked about. 
    # By dividing the raw scores before the softmax, we control the 
    # "concentration" of the probability.
    
    probs = F.softmax(logits_scaled, dim=1)[0].cpu().numpy()
    # ↑ ANNOTATION: Softmax converts those raw scores into a probability 
    # distribution where all values add up to 1.
    
    top_idx = probs.argsort()[::-1][:top_k]
    # ↑ ANNOTATION: argsort() gives us the indices of the values. 
    # [::-1] reverses it so the highest score is first.
    
    result = []
    for idx in top_idx:
        p = float(probs[idx])
        if p < min_confidence:
            continue
        # ↑ ANNOTATION: We drop 'noise'. If the model is only 2% sure, 
        # it's usually just background hallucination.
        
        result.append({
            "intent_label": int(idx),
            "intent_name": INTENT_CLASSES.get(int(idx), "unknown_intent"),
            "confidence": p,
            "priority": INTENT_PRIORITY.get(INTENT_CLASSES.get(int(idx), ""), 0)
        })
    return result
```

