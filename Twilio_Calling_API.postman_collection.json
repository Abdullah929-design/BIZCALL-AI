	"item": [
		{
			"name": "Outbound",
			"item": [
				{
					"name": "Initiate Outbound Call",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"to_number\": \"+15005550001\",\n    \"business_context\": \"New high-interest savings account (4.5% APY)\",\n    \"instructions\": \"Be polite, focus on the interest rate, and ask if they have 5 minutes to chat. If they say no, thank them and end call.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/api/twilio/initiate-outbound",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"twilio",
								"initiate-outbound"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Call Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/twilio/call-status/CAxxxxxxxx",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"twilio",
								"call-status",
								"CAxxxxxxxx"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Webhooks (Simulation)",
			"item": [
				{
					"name": "Simulate Inbound Webhook",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "CallSid",
									"value": "CA12345",
									"type": "text"
								},
								{
									"key": "From",
									"value": "+1234567890",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{BASE_URL}}/api/twilio/inbound-call",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"twilio",
								"inbound-call"
							]
						}
					},
					"response": []
				},
				{
					"name": "Simulate Process Call (Speech)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "SpeechResult",
									"value": "How do I reset my account password?",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{BASE_URL}}/api/twilio/process-call?session_id={{SESSION_ID}}",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"twilio",
								"process-call"
							],
							"query": [
								{
									"key": "session_id",
									"value": "{{SESSION_ID}}"
								}
							]
						}
					},
					"response": []
				}
			]
		},
